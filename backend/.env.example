# Copy to .env and fill in. Never commit the real .env (already gitignored).

# ElevenLabs text-to-speech. Get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice to use for type-to-speak. Any voice_id from your ElevenLabs account/library;
# this is a placeholder (ElevenLabs' public "Rachel" voice) until we pick a real one.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Low-latency model so type-to-speak doesn't feel like it's hanging.
# eleven_flash_v2_5 ~75ms median inference latency per ElevenLabs docs (Oct 2026).
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional local sound classification. Leave empty to run without YAMNet.
# Download the model first; path is relative to the backend working directory.
YAMNET_MODEL_DIR=
